# Canonical origin. Required in production: canonical tags, Open Graph URLs,
# sitemap.xml and robots.txt are all derived from it.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only GitHub token. OPTIONAL — the site builds and runs without it.
#
#   without a token : featured repositories load from the public REST API
#                     (60 requests/hour per IP); the contribution grid shows
#                     the design's placeholder pattern.
#   with a token    : the contribution grid shows real data, and REST moves to
#                     5000 requests/hour.
#
# GitHub serves the contribution calendar through GraphQL only, and GraphQL
# rejects unauthenticated requests — so real contribution data REQUIRES this.
#
# Classic PAT: no scopes need to be ticked for public data; add `read:user`
# if the calendar comes back empty.
#
# Never rename this to NEXT_PUBLIC_GITHUB_TOKEN — that would ship it to the browser.
GITHUB_TOKEN=
